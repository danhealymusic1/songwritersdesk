---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink bg-paper mt-24">
  <div class="max-w-7xl mx-auto px-8 pt-12 pb-8">
    <div class="folio mb-8">
      <span>The Songwriter's Desk</span>
      <span>songwritersdesk.com</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr_1fr] gap-10 mb-10">
      <div>
        <div class="serif text-3xl leading-[1.05] tracking-tight max-w-sm">A quiet desk for loud work.</div>
        <div class="text-sm text-ink-muted mt-4 leading-relaxed">
          Hosted by Dan Healy. Built for the song, not the algorithm.
        </div>
      </div>
      <div>
        <div class="kicker mb-3">Sections</div>
        <div class="flex flex-col gap-2 text-sm">
          <a class="no-underline" href="/">Home</a>
          <a class="no-underline" href="/tools">Tools</a>
          <a class="no-underline" href="/resources">Resources</a>
          <a class="no-underline" href="/blog">Blog</a>
          <a class="no-underline" href="/about">About</a>
        </div>
      </div>
      <div>
        <div class="kicker mb-3">Templates</div>
        <div class="flex flex-col gap-2 text-sm">
          <a class="no-underline" href="/resources/split-sheet-blank.pdf">Split sheet</a>
          <a class="no-underline" href="/resources/co-write-agreement-blank.pdf">Co-write</a>
          <a class="no-underline" href="/resources/release-checklist.pdf">Release checklist</a>
          <a class="no-underline" href="/resources/session-tracking-sheet.pdf">Session tracker</a>
        </div>
      </div>
      <div>
        <div class="kicker mb-3">Elsewhere</div>
        <div class="flex flex-col gap-2 text-sm">
          <a class="no-underline" href="/#newsletter">Newsletter</a>
          <a class="no-underline" href="https://instagram.com/songwritersdesk" target="_blank" rel="noopener">Instagram</a>
          <a class="no-underline" href="mailto:dan@songwritersdesk.com">Email Dan</a>
        </div>
      </div>
    </div>

    <div class="border-t border-line pt-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2">
      <div class="mono text-[10px] tracking-tracker text-ink-muted uppercase">
        &copy; {year} The Songwriter's Desk · All rights reserved
      </div>
      <div class="serif italic text-sm text-ink-muted">"Measure twice, split once."</div>
    </div>
  </div>
</footer>
