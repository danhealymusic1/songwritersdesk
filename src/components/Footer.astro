---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 mt-24 py-10 bg-paper relative z-10">
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row gap-6 justify-between items-start text-sm text-ink-muted">
    <div class="flex items-start gap-3">
      <img src="/logo.png" alt="" class="h-10 w-auto flex-shrink-0" />
      <div>
        <div class="serif text-lg text-ink font-semibold">The Songwriter's Desk</div>
        <div class="mt-1">Tools, templates and honest advice for working songwriters.</div>
        <div class="mt-1">Hosted by Dan Healy.</div>
      </div>
    </div>
    <div class="flex flex-col gap-1 md:text-right">
      <a href="/tools" class="no-underline hover:underline">Tools</a>
      <a href="/resources" class="no-underline hover:underline">Resources</a>
      <a href="/blog" class="no-underline hover:underline">Blog</a>
      <a href="/about" class="no-underline hover:underline">About</a>
      <div class="mt-3 text-xs">&copy; {year} The Songwriter's Desk</div>
    </div>
  </div>
</footer>
