---
// Logo option A — staff-line monogram with "note paper"
// Used as the primary site mark.
const links = [
  { href: '/tools', label: 'Tools' },
  { href: '/resources', label: 'Resources' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
const { pathname } = Astro.url;

const now = new Date();
const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const issueLabel = `${monthNames[now.getMonth()]} ${now.getFullYear()}`;
---

<header class="border-b border-ink/20 bg-paper">
  <div class="max-w-7xl mx-auto px-8 py-6 grid grid-cols-[1fr_auto_1fr] items-center gap-6">
    <!-- Mark + title -->
    <a href="/" class="no-underline flex items-center gap-3">
      <!-- Logo A: staff + italic SD monogram on paper -->
      <span class="inline-block bg-paper-warm border border-line rounded-sm p-1" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <line x1="4" y1="11" x2="36" y2="11" stroke="#1A1814" stroke-width="0.8" />
          <line x1="4" y1="17" x2="36" y2="17" stroke="#1A1814" stroke-width="0.8" />
          <line x1="4" y1="23" x2="36" y2="23" stroke="#1A1814" stroke-width="0.8" />
          <line x1="4" y1="29" x2="36" y2="29" stroke="#1A1814" stroke-width="0.8" />
          <text x="20" y="26.5" text-anchor="middle" font-family="Fraunces, serif"
            font-weight="600" font-size="18" font-style="italic" fill="#1A1814">SD</text>
        </svg>
      </span>
      <span>
        <span class="serif text-[17px] font-medium tracking-tight block leading-none">The Songwriter's Desk</span>
        <span class="mono text-[9px] tracking-tracker text-ink-muted uppercase block mt-1">Issue N° · {issueLabel}</span>
      </span>
    </a>

    <!-- Est. line (middle) -->
    <div class="hidden md:block mono text-[10px] tracking-tracker text-ink-muted uppercase text-center">
      Est. 2026
    </div>

    <!-- Nav -->
    <nav class="flex gap-7 justify-end text-sm">
      {links.map(({ href, label }) => {
        const active = pathname === href || (href !== '/' && pathname.startsWith(href));
        return (
          <a
            href={href}
            class={`no-underline font-medium ${active ? 'text-accent border-b border-accent pb-[2px]' : 'text-ink hover:text-accent'}`}
          >{label}</a>
        );
      })}
    </nav>
  </div>
</header>
