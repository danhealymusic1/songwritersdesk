---
const links = [
  { href: '/tools', label: 'Tools' },
  { href: '/resources', label: 'Resources' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
const { pathname } = Astro.url;
---

<header class="border-b border-ink/10 bg-paper">
  <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="/" class="no-underline flex items-baseline gap-2">
      <span class="serif text-xl font-bold tracking-tight">The Songwriter's Desk</span>
    </a>
    <nav class="flex gap-6 text-sm">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class={`no-underline hover:text-accent ${pathname.startsWith(href) ? 'text-accent' : 'text-ink-soft'}`}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
