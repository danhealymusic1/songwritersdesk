---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Flip this to false to switch from coming-soon mode to the full homepage.
const COMING_SOON = true;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="The Songwriter's Desk">
  {COMING_SOON ? (
    <section class="max-w-xl mx-auto text-center py-16">
      <h1 class="serif text-5xl md:text-6xl mb-4 leading-tight">The Songwriter's Desk</h1>
      <p class="text-lg text-ink-soft mb-2">Tools, templates and honest advice for working songwriters.</p>
      <p class="text-sm text-ink-muted mb-10">Hosted by Dan Healy.</p>

      <div class="bg-paper-warm border border-ink/10 rounded-lg p-8 text-left">
        <h2 class="serif text-xl mb-2">Coming soon.</h2>
        <p class="text-ink-soft mb-5">
          A songwriter's toolkit I always wanted — slant-rhyme finder, a song idea generator,
          a split sheet maker, a royalty calculator, and a blog where I show my working.
        </p>
        <p class="text-ink-soft mb-6 text-sm">Drop your email and I'll tell you when it's live.</p>

        <iframe
          src="https://subscribe-forms.beehiiv.com/5fc2e95f-4778-4af0-8c37-17455d00995b"
          class="beehiiv-embed"
          data-test-id="beehiiv-embed"
          frameborder="0"
          scrolling="no"
          style="width: 100%; height: 56px; margin: 0; border-radius: 0 !important; background-color: transparent;"
        ></iframe>
      </div>

      <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
    </section>
  ) : (
    <>
      <section class="py-12 border-b border-ink/10">
        <h1 class="serif text-5xl md:text-6xl mb-4 leading-tight max-w-3xl">
          Tools, templates and honest advice for working songwriters.
        </h1>
        <p class="text-lg text-ink-soft max-w-2xl mb-8">
          Slant rhyme finder, song idea generator, split sheet maker, royalty calculator —
          plus a blog where I show my working. Hosted by Dan Healy.
        </p>
        <div class="flex gap-4 flex-wrap">
          <a href="/tools" class="px-5 py-3 rounded-md bg-ink text-paper no-underline hover:bg-accent transition">Browse the tools</a>
          <a href="/blog" class="px-5 py-3 rounded-md border border-ink/20 no-underline hover:border-accent hover:text-accent transition">Read the blog</a>
        </div>
      </section>

      <section class="py-12 border-b border-ink/10">
        <h2 class="serif text-3xl mb-6">Featured tools</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/tools/songstarter" class="block p-5 rounded-lg border border-ink/10 hover:border-accent no-underline bg-paper-warm">
            <div class="serif text-xl mb-1">Songstarter</div>
            <div class="text-sm text-ink-muted">Specific song starting points based on who you are, how you feel, and the vibe you want.</div>
          </a>
          <a href="/tools" class="block p-5 rounded-lg border border-ink/10 hover:border-accent no-underline bg-paper-warm">
            <div class="serif text-xl mb-1">Slant rhyme finder</div>
            <div class="text-sm text-ink-muted">Near-rhymes, multi-syllable rhymes, assonance — tuned for how modern songs actually rhyme.</div>
          </a>
          <a href="/tools" class="block p-5 rounded-lg border border-ink/10 hover:border-accent no-underline bg-paper-warm">
            <div class="serif text-xl mb-1">Split sheet generator</div>
            <div class="text-sm text-ink-muted">A proper printable split sheet in under two minutes. Free, no signup.</div>
          </a>
        </div>
      </section>

      <section class="py-12">
        <h2 class="serif text-3xl mb-6">From the blog</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="block no-underline">
              <div class="serif text-xl mb-1">{post.data.title}</div>
              <div class="text-sm text-ink-muted mb-1">
                {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
              <div class="text-ink-soft">{post.data.description}</div>
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>
