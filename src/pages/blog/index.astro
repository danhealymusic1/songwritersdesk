---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Honest writing on songwriting craft, the music business, and the songs I'm actually working on."
>
  <section class="mb-10">
    <h1 class="serif text-4xl mb-3">Blog</h1>
    <p class="text-ink-soft max-w-2xl">
      Notes on craft, the business, and the songs I'm actually working on.
    </p>
  </section>

  <ul class="space-y-8">
    {posts.map((post) => (
      <li class="border-b border-ink/10 pb-8 last:border-none">
        <a href={`/blog/${post.slug}`} class="no-underline block">
          <div class="text-sm text-ink-muted mb-1">
            {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          </div>
          <h2 class="serif text-2xl mb-1">{post.data.title}</h2>
          <p class="text-ink-soft">{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
