---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Inline Lucide SVG bodies (stroke-based, currentColor) — no runtime dep.
const ICONS = {
  compass: `<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`,
  book: `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>`,
  handshake: `<path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>`,
  calculator: `<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>`,
  lightbulb: `<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>`,
  layout: `<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>`,
};

const tools = [
  {
    href: '/tools/songstarter',
    name: 'Songstarter',
    tagline: 'Specific song starting points based on who you are, how you feel, and the vibe you want.',
    status: 'live',
    icon: 'compass',
  },
  {
    href: '/tools/slant-rhymes',
    name: 'Slant rhyme finder',
    tagline: 'Near-rhymes, multi-syllable rhymes, assonance. Tuned for modern songwriting.',
    status: 'live',
    icon: 'book',
  },
  {
    href: '/tools/split-sheet',
    name: 'Split sheet generator',
    tagline: 'A proper printable split sheet in under two minutes. Free, no signup.',
    status: 'live',
    icon: 'handshake',
  },
  {
    href: '/tools/royalty-calculator',
    name: 'Royalty split calculator',
    tagline: "Punch in the streams, see what each writer actually receives.",
    status: 'live',
    icon: 'calculator',
  },
  {
    href: '/tools/song-title-generator',
    name: 'Song title generator',
    tagline: 'Titles by mood, genre, or theme. Filterable from cryptic to literal.',
    status: 'coming-soon',
    icon: 'lightbulb',
  },
  {
    href: '/tools/song-structure',
    name: 'Song structure builder',
    tagline: 'Pick a structure, see named examples, export a template.',
    status: 'coming-soon',
    icon: 'layout',
  },
];
---

<BaseLayout
  title="Songwriter tools"
  description="Free tools for songwriters: song idea generator, slant rhyme finder, split sheet generator, royalty calculator, and more."
>
  <section class="mb-10">
    <h1 class="serif text-4xl mb-3">The tools</h1>
    <p class="text-ink-soft max-w-2xl">
      Free, fast, and made by a working songwriter. Every tool has a proper guide
      underneath it explaining what it's for and how to use it well.
    </p>
  </section>

  <div class="grid sm:grid-cols-2 gap-5">
    {tools.map((tool) => (
      <a
        href={tool.status === 'live' ? tool.href : '#'}
        class={`block p-6 rounded-lg border no-underline transition ${
          tool.status === 'live'
            ? 'border-ink/10 hover:border-accent bg-paper-warm'
            : 'border-ink/10 opacity-60 cursor-default bg-paper'
        }`}
      >
        <div class="flex items-start justify-between gap-4 mb-2">
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2 mb-1">
              <div class="serif text-xl">{tool.name}</div>
              {tool.status !== 'live' && (
                <span class="text-xs uppercase tracking-wider text-ink-muted">Coming soon</span>
              )}
            </div>
            <div class="text-sm text-ink-muted">{tool.tagline}</div>
          </div>
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-accent flex-shrink-0 mt-1"
            aria-hidden="true"
            set:html={ICONS[tool.icon]}
          />
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
