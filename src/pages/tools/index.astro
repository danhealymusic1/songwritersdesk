---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { n: '01', href: '/tools/songstarter', name: 'Songstarter', tag: 'Ideation',
    d: "Specific song starting points based on who you are, how you feel, and the vibe you want. Not prompts — openings.", status: 'live' },
  { n: '02', href: '/tools/slant-rhymes', name: 'Slant rhyme finder', tag: 'Lyric',
    d: 'Near-rhymes, multi-syllable rhymes, assonance. Tuned for modern songwriting where perfect rhymes sound dated.', status: 'live' },
  { n: '03', href: '/tools/split-sheet', name: 'Split sheet generator', tag: 'Business',
    d: 'A proper printable split sheet in under two minutes. Free, no signups. PDF out.', status: 'live' },
  { n: '04', href: '/tools/royalty-calculator', name: 'Royalty split calculator', tag: 'Business',
    d: "Punch in the streams and shares, see what each writer actually receives after PRO, publisher, and admin fees.", status: 'live' },
  { n: '05', href: '/tools/song-title-generator', name: 'Song title generator', tag: 'Ideation',
    d: 'Filter by mood, genre, or theme. Five titles at a time.', status: 'soon' },
  { n: '06', href: '/tools/song-structure', name: 'Song structure builder', tag: 'Structure',
    d: 'Pick a structure, see named examples, export a template for your DAW.', status: 'soon' },
];

const liveCount = tools.filter(t => t.status === 'live').length;
const soonCount = tools.length - liveCount;
---

<BaseLayout
  title="Songwriter tools"
  description="Free tools for songwriters: song idea generator, slant rhyme finder, split sheet generator, royalty calculator, and more."
  wide={true}
>
  <section class="max-w-7xl mx-auto px-8 pt-12 pb-10">
    <div class="folio"><span>§01 — Tools index</span><span>{String(tools.length).padStart(2,'0')} items · {String(liveCount).padStart(2,'0')} live · {String(soonCount).padStart(2,'0')} in build</span></div>
    <h1 class="serif font-light tracking-[-0.04em] leading-[0.95] mt-5" style="font-size: clamp(64px, 10vw, 120px);">
      The <span class="italic">tools</span>.
    </h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mt-8">
      <p class="serif text-lg leading-[1.5] text-ink-soft max-w-lg">
        Free, fast, and made by a working songwriter. Every tool has a proper guide underneath it — what it's for, how to use it well, and what to watch out for.
      </p>
      <div class="flex items-end justify-end gap-6 flex-wrap">
        {['All','Ideation','Lyric','Structure','Business'].map((f, i) => (
          <span class={`mono text-[11px] tracking-tracker uppercase pb-[2px] ${i===0?'text-ink border-b-[1.5px] border-ink':'text-ink-muted'}`}>{f}</span>
        ))}
      </div>
    </div>
  </section>

  <div class="border-t border-ink"></div>

  {tools.map((tool) => (
    <a
      href={tool.status === 'live' ? tool.href : '#'}
      class={`no-underline grid grid-cols-[60px_1.3fr_2fr_120px] md:grid-cols-[80px_1.3fr_2fr_120px] items-stretch border-b border-line gap-6 md:gap-8 px-8 py-8 max-w-7xl mx-auto ${tool.status==='soon'?'bg-paper-warm opacity-90':'hover:bg-paper-warm transition'}`}
    >
      <div class="serif italic font-light text-accent leading-none" style="font-size:52px;">{tool.n}</div>
      <div>
        <div class="kicker mb-2">{tool.tag}</div>
        <div class="serif text-[28px] md:text-[32px] font-medium tracking-[-0.015em] leading-[1.05]">{tool.name}</div>
      </div>
      <div class="text-[15px] text-ink-soft leading-[1.55]">{tool.d}</div>
      <div class="flex items-center justify-end">
        <span class={`mono text-[10px] tracking-tracker uppercase border px-3 py-1.5 ${tool.status==='live'?'text-moss border-moss':'text-ink-muted border-line'}`}>
          {tool.status==='live'?'● Open →':'○ Soon'}
        </span>
      </div>
    </a>
  ))}
</BaseLayout>
