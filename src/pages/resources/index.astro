---
import BaseLayout from '../../layouts/BaseLayout.astro';

const templates = [
  {
    t: 'Blank split sheet',
    d: 'Printable split sheet. Fill in the writers, shares, PROs, and signatures by hand. Two pages — one for splits, one for signatures.',
    pages: '02',
    href: '/resources/split-sheet-blank.pdf',
  },
  {
    t: 'Co-write agreement',
    d: 'A short, plain-English agreement between co-writers covering ownership, administration, sync consent, and good-faith cooperation.',
    pages: '02',
    href: '/resources/co-write-agreement-blank.pdf',
  },
  {
    t: 'Release & metadata checklist',
    d: "Everything that should be locked down before a song goes live: ISRC/ISWC, splits, registrations, credits, artwork, and post-release actions.",
    pages: '02',
    href: '/resources/release-checklist.pdf',
  },
  {
    t: 'Session & demo tracking sheet',
    d: 'Who was in the room, the key and tempo, chord progressions, demo filenames, and action items — while you still remember.',
    pages: '01',
    href: '/resources/session-tracking-sheet.pdf',
  },
];

const directory = {
  'UK & Ireland': [
    { name: 'PRS for Music', url: 'https://www.prsformusic.com', what: 'UK performing rights — collects performance royalties when your songs are played on radio, TV, and in public venues.' },
    { name: 'MCPS', url: 'https://www.prsformusic.com/what-we-do/who-we-represent/songwriters-and-composers/mcps-membership', what: 'UK mechanical rights — collects royalties when your songs are reproduced (streams, downloads, CDs, vinyl).' },
    { name: 'PPL', url: 'https://www.ppluk.com', what: 'UK neighbouring rights — for performers and recording owners when recordings are played publicly. Separate from PRS.' },
    { name: 'Sentric Music', url: 'https://www.sentricmusic.com', what: 'UK-based publishing administrator. Free tier for independent songwriters — collects worldwide publishing income.' },
    { name: 'The Ivors Academy', url: 'https://ivorsacademy.com', what: 'UK professional body for songwriters and composers. Advocacy, education, and the Ivor Novello Awards.' },
    { name: 'IMRO', url: 'https://www.imro.ie', what: 'Ireland — performance rights organisation for Irish songwriters and publishers.' },
  ],
  'United States': [
    { name: 'ASCAP', url: 'https://www.ascap.com', what: 'US performing rights org. Free to join for songwriters. Collects performance royalties in the US.' },
    { name: 'BMI', url: 'https://www.bmi.com', what: 'US performing rights org. Free for songwriters. Direct competitor to ASCAP — you can only join one.' },
    { name: 'SESAC', url: 'https://www.sesac.com', what: 'US performing rights org. Invite-only. Smaller, boutique roster — generally considered for established writers.' },
    { name: 'The MLC', url: 'https://www.themlc.com', what: 'The US Mechanical Licensing Collective. Collects mechanical royalties from US streams — you should register if you self-publish.' },
    { name: 'SoundExchange', url: 'https://www.soundexchange.com', what: 'US digital performance royalties for sound recordings (non-interactive streams like Pandora, SiriusXM). Performer + master owner income.' },
    { name: 'Songtrust', url: 'https://www.songtrust.com', what: 'Publishing administrator. Paid flat fee, registers your songs at every collection society worldwide and collects the money most writers leave on the table.' },
    { name: 'CD Baby Pro / Publishing', url: 'https://cdbaby.com/publishing', what: 'Combined distribution + publishing administration for independent artists. Convenient if you already distribute via CD Baby.' },
    { name: 'AMRA', url: 'https://www.amra.com', what: 'Digital collection society focused on global streaming royalties. Often partners with other PROs rather than replacing them.' },
  ],
  'Europe, Canada & Global': [
    { name: 'SOCAN', url: 'https://www.socan.com', what: "Canada's performing rights org. Covers performance, mechanical, and reproduction rights." },
    { name: 'GEMA', url: 'https://www.gema.de', what: 'German performing and mechanical rights.' },
    { name: 'SACEM', url: 'https://www.sacem.fr', what: 'French performing rights.' },
    { name: 'SIAE', url: 'https://www.siae.it', what: 'Italian rights society.' },
    { name: 'APRA AMCOS', url: 'https://www.apraamcos.com.au', what: 'Australia and New Zealand performing and mechanical rights.' },
  ],
};
---

<BaseLayout
  title="Resources"
  description="Free printable split sheets, co-write agreements, release checklists, plus a hand-curated list of the publishing admins, PROs, and collection societies every working songwriter should know."
  wide={true}
>
  <section class="max-w-7xl mx-auto px-8 pt-12 pb-8">
    <div class="folio"><span>§02 — Resources</span><span>PDFs & industry directory</span></div>
    <h1 class="serif font-light tracking-[-0.04em] leading-[0.95] mt-5" style="font-size:clamp(64px,10vw,120px);">
      <span class="italic">Re</span>sources.
    </h1>
    <p class="serif text-[19px] leading-[1.5] text-ink-soft mt-6 max-w-2xl">
      Printable templates you can download, print, and fill in by hand. Plus a curated directory of the publishing administrators and collection societies every working songwriter should know about.
    </p>
  </section>

  <div class="border-t border-ink"></div>

  {/* ── Templates ── */}
  <section class="max-w-7xl mx-auto px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 mb-10">
      <div>
        <div class="folio"><span>A</span><span>Printable templates</span></div>
        <div class="serif font-light tracking-[-0.03em] leading-[0.95] mt-3" style="font-size:clamp(40px,5vw,54px);">Paper forms.<br/><span class="italic text-accent">Still the best.</span></div>
      </div>
      <div class="text-[15px] text-ink-muted leading-relaxed self-end max-w-lg">
        Blank PDFs designed to be printed and signed by hand. Keep them in a folder, a Dropbox, or tape them to your studio wall.
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 border border-ink">
      {templates.map((t, i) => (
        <a href={t.href} target="_blank" rel="noopener" class={`no-underline p-7 min-h-[220px] flex flex-col justify-between hover:bg-paper-warm transition ${i%2===0?'md:border-r border-ink':''} ${i<2?'md:border-b border-ink':''}`}>
          <div class="flex gap-6">
            <div class="w-20 h-[104px] bg-paper border border-line p-2 flex-shrink-0 relative">
              <div class="h-[3px] bg-accent mb-1.5"></div>
              <div class="serif text-[7px] font-semibold leading-tight mb-1">{t.t}</div>
              {Array.from({length: 6}).map(() => <div class="h-[1px] bg-line mb-1"></div>)}
              <div class="absolute bottom-1 right-1.5 mono text-[5px] text-ink-muted">PDF</div>
            </div>
            <div class="flex-1">
              <div class="flex justify-between mb-1">
                <span class="mono text-[10px] tracking-tracker text-accent uppercase">Template · PDF</span>
                <span class="mono text-[10px] tracking-tracker text-ink-muted">{t.pages} pp</span>
              </div>
              <div class="serif text-2xl font-medium leading-tight mb-2">{t.t}</div>
              <div class="text-sm text-ink-muted leading-[1.55]">{t.d}</div>
            </div>
          </div>
          <div class="flex justify-between items-center mt-5 pt-4 border-t border-line">
            <span class="mono text-[10px] tracking-tracker text-ink-muted uppercase">Free · No signups</span>
            <span class="mono text-[11px] tracking-tracker text-ink uppercase border-b-[1.5px] border-ink pb-[2px]">Download ↓</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="border-t border-ink"></div>

  {/* ── Directory ── */}
  <section class="max-w-7xl mx-auto px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 mb-10">
      <div>
        <div class="folio"><span>B</span><span>Industry directory</span></div>
        <div class="serif font-light tracking-[-0.03em] leading-[0.95] mt-3" style="font-size:clamp(40px,5vw,54px);">Who does<br/><span class="italic">what</span>, and why.</div>
      </div>
      <div class="text-[15px] text-ink-muted leading-relaxed self-end max-w-lg">
        A non-exhaustive list of the organisations that handle the money side of songwriting. Not affiliate links. Not endorsements. Just who does what, so you can find the right door to knock on.
      </div>
    </div>

    {Object.entries(directory).map(([region, rows]) => (
      <div class="mb-10">
        <div class="flex items-baseline gap-4 border-b border-ink pb-2 mb-1">
          <div class="serif italic text-[26px] font-normal">{region}</div>
          <div class="mono text-[10px] tracking-tracker text-ink-muted uppercase">{rows.length} organisations</div>
        </div>
        {rows.map((r) => (
          <a href={r.url} target="_blank" rel="noopener" class="no-underline grid grid-cols-1 md:grid-cols-[240px_1fr_200px] gap-6 py-4 border-b border-line items-center hover:bg-paper-warm transition">
            <div class="serif text-xl font-medium flex items-center gap-2">
              {r.name} <span class="text-accent text-sm">↗</span>
            </div>
            <div class="text-sm text-ink-soft leading-[1.55]">{r.what}</div>
            <div class="mono text-[11px] text-ink-muted md:text-right">{r.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '')}</div>
          </a>
        ))}
      </div>
    ))}
  </section>

  <div class="border-t border-ink"></div>

  {/* ── Which do I need? ── */}
  <section class="max-w-3xl mx-auto px-8 py-16">
    <div class="folio mb-6"><span>C</span><span>A quick primer</span></div>
    <h2 class="serif font-light tracking-[-0.03em] leading-[1]" style="font-size:clamp(36px,5vw,48px);">
      Which of these do I <span class="italic">actually</span> need?
    </h2>
    <div class="prose mt-8">
      <p>
        If you're a songwriter — not a performing artist — the short answer is:
        one PRO (ASCAP, BMI, PRS, SOCAN, APRA, etc. — whichever covers your
        country), and one publishing administrator (Songtrust, Sentric, CD
        Baby, etc.). That gets you the majority of the money your songs earn
        globally.
      </p>
      <p>
        If you're also the performer on the recording, add PPL (UK) or
        SoundExchange (US) to collect your neighbouring-rights income, which is
        a separate pot of money with your name on it.
      </p>
      <p>
        If you self-publish in the US, register with The MLC so you get the
        mechanical royalties from US streams. Everyone else's admin covers this
        automatically.
      </p>
      <h3>A note on choosing between them</h3>
      <p>
        Most of these services won't move the needle massively for a writer
        earning under a few hundred pounds a year. But they will stop you
        missing out on money that's <em>already been collected with your name
        on it</em> — money that gets written off as "unmatched" if nobody
        claims it. The difference between signing up and not is the difference
        between "I don't earn much from songwriting" and "I earn the same
        amount, but actually receive it."
      </p>
    </div>
  </section>
</BaseLayout>
